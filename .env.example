APP_NAME="CCM Activos Morales"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_MAX_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
MFA_EXPIRES_MINUTES=5
MFA_MAX_ATTEMPTS=5

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CHANNEL=sms
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

INITIAL_ACCESS_PASSWORD=CAMBIAR_EN_CADA_INSTALACION

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=ccm_activos
DB_USERNAME=ccm_app_dev
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_ALEATORIO

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@moralesmun.gob.pe"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Escenario ficticio para sustentación (mantener desactivado en producción).
DEMO_SCENARIO_ENABLED=true
DEMO_ASSISTANT_PASSWORD=CAMBIAR_POR_UNA_CLAVE_DEMO
